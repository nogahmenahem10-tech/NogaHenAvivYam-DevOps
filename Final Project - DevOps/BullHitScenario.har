          "content": {
            "size": 1373,
            "mimeType": "text/html",
            "compression": -1,
            "text": "\r\n\r\n\r\n\r\n\r\n<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Bull Hit Game</title>\r\n</head>\r\n\r\n<body>\r\n\r\n    <h1>Bull Hit Game</h1>\r\n\r\n    <p>\r\n        Guess the secret combination of 4 different letters between A and H.\r\n    </p>\r\n\r\n    <form method=\"post\">\r\n\r\n        <label for=\"guess\">Enter your guess:</label>\r\n\r\n        <input\r\n            type=\"text\"\r\n            id=\"guess\"\r\n            name=\"guess\"\r\n            maxlength=\"4\"\r\n            placeholder=\"ABCD\"\r\n            required\r\n        >\r\n\r\n        <button type=\"submit\">Check Guess</button>\r\n\r\n    </form>\r\n\r\n   \r\n\r\n    <h3>Bulls: 4 | Hits: 0 - You won!</h3>\r\n\r\n\r\n\r\n\r\n\r\n    <h2>Guess History</h2>\r\n\r\n    <ul>\r\n        \r\n            <li>ABCD - Bulls: 0 | Hits: 2</li>\r\n        \r\n            <li>EFAB - Bulls: 0 | Hits: 2</li>\r\n        \r\n            <li>GHEF - Bulls: 1 | Hits: 1</li>\r\n        \r\n            <li>GABH - Bulls: 2 | Hits: 0</li>\r\n        \r\n            <li>GCDH - Bulls: 1 | Hits: 1</li>\r\n        \r\n            <li>HCAE - Bulls: 0 | Hits: 4</li>\r\n        \r\n            <li>CAEH - Bulls: 4 | Hits: 0 - You won!</li>\r\n        \r\n    </ul>\r\n\r\n\r\n\r\n\r\n<br>\r\n\r\n<a href=\"rules.jsp\">How to Play</a>\r\n\r\n<br><br>\r\n\r\n<form method=\"post\" action=\"index.jsp\">\r\n    <input type=\"hidden\" name=\"action\" value=\"reset\">\r\n    <button type=\"submit\">New Game</button>\r\n</form>\r\n\r\n</body>\r\n\r\n</html>\r\n"
          },
          "redirectURL": "",
          "headersSize": 162,
          "bodySize": 1374,
          "_transferSize": 1536,
