            "mimeType": "text/html",
            "compression": -1,
            "text": "\r\n\r\n<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>How to Play</title>\r\n</head>\r\n\r\n<body>\r\n\r\n    <h1>How to Play</h1>\r\n\r\n    <p>Guess a combination of 4 different letters from A to H.</p>\r\n\r\n    <p>\r\n        A Bull means that the letter is correct and in the correct position.\r\n    </p>\r\n\r\n    <p>\r\n        A Hit means that the letter exists in the secret combination,\r\n        but is in the wrong position.\r\n    </p>\r\n\r\n    <a href=\"index.jsp\">Back to Game</a>\r\n\r\n</body>\r\n</html>"
          },
